[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/mit-pdos/xv6-riscv.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "riscv"]
	remote = origin
	merge = refs/heads/riscv
	vscode-merge-base = origin/riscv
